{
  "name": "first-you",
  "description": "Screen Time for your thinking — try before you ask AI.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "zip": "node scripts/check-release.mjs && wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "test:e2e": "E2E=1 wxt build && playwright test",
    "check-release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
